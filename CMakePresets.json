{
  "version": 3,
  "cmakeMinimumRequired": 
  {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": 
  [
    {
      "name": "default",
      "displayName": "default ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": 
      {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_MAKE_PROGRAM": "ninja"
      }
      
    }
  ]
}